# Supabase PostgreSQL connection string.
# Both postgres:// URI and normal Npgsql connection-string formats are supported.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,https://your-custom-domain.com

# Only these reverse-proxy networks are allowed to supply X-Forwarded-For/X-Forwarded-Proto.
# Fill this with the actual Railway proxy CIDR(s) for your environment before production.
TRUSTED_PROXY_CIDRS=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_SECRET=replace-with-another-long-random-secret
