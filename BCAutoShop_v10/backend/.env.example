# Reference only: ASP.NET does NOT load this file automatically.
# Set these in Railway Variables or dotnet user-secrets.
DATABASE_CONNECTION_STRING=Host=YOUR-SESSION-POOLER-HOST;Port=5432;Database=postgres;Username=postgres.YOUR-PROJECT-REF;Password=YOUR-DATABASE-PASSWORD;SSL Mode=VerifyFull;GSS Encryption Mode=Disable;Maximum Pool Size=10
ADMIN_USERNAME=viktor
ADMIN_PASSWORD=REPLACE-WITH-UNIQUE-PASSWORD-AT-LEAST-16-CHARS
ADMIN_TOKEN_SECRET=REPLACE-WITH-RANDOM-SECRET-AT-LEAST-32-CHARS
RATE_LIMIT_SECRET=REPLACE-WITH-ANOTHER-RANDOM-SECRET-AT-LEAST-32-CHARS
ALLOWED_ORIGINS=https://YOUR-SITE.vercel.app
# Fill from verified Railway ingress addresses/CIDRs; never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_NETWORKS=
FORWARDED_FOR_HEADER=X-Real-IP
LOG_PROXY_PEER=false
ASPNETCORE_ENVIRONMENT=Production
